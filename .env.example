# Copy to .env (gitignored) and fill in. Never commit real values.

# ---- WorldQuant BRAIN ----
# Your own account. Used by the catalog fetcher (stage 1) and the simulation
# runner (stage 2). Submission is never automated — see docs/DECISIONS.md.
BRAIN_EMAIL=
BRAIN_PASSWORD=

# ---- LLM ----
# "fake" (tests/offline) | "openrouter" | "anthropic"
# Used only for field triage — reading field descriptions to tell a real signal
# from metadata. It never writes expressions and never judges results.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Tier -> concrete model. Call sites name a *capability*, never a model, so
# switching provider is this block plus LLM_PROVIDER — no code change.
# When using OpenRouter you MUST override all four: a Claude model id sent to
# OpenRouter is a 404, not a fallback.
# Field triage runs on CHEAP_CLASSIFICATION -> the HAIKU tier.
LLM_MODEL_HAIKU=deepseek/deepseek-v4-flash-0731
LLM_MODEL_SONNET=deepseek/deepseek-v4-flash-0731
LLM_MODEL_OPUS=deepseek/deepseek-v4-flash-0731
LLM_MODEL_RESERVE=deepseek/deepseek-v4-flash-0731

# ---- Local database ----
# Blank => <repo>/database/wq.db
DATABASE_URL=

LOG_LEVEL=INFO
LOG_JSON=false
